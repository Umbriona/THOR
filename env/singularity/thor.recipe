Bootstrap: docker
From: nvcr.io/nvidia/tensorflow:23.09-tf2-py3

# Single container for the whole THOR pipeline: training, generation,
# ET-regressor training and prediction, ESM-1v fine-tuning, and feature
# computation. Build with:
#
#     singularity build thor.sif thor.recipe
#
# The base is the public NGC TensorFlow 23.09 image (TensorFlow 2.13, CUDA
# 11.8, cuDNN 8.9). The previous recipe bootstrapped from a cluster-local copy
# of the same image (/apps/containers/TensorFlow/TensorFlow-2.13.0-NGC-23.09.sif),
# which only resolves on Alvis; nvcr.io is reachable anywhere.

%labels
    Name        THOR
    Description THermally Optimised Representations - full pipeline
    Base        nvcr.io/nvidia/tensorflow:23.09-tf2-py3

%environment
    export LD_LIBRARY_PATH=/usr/local/cuda/extras/CUPTI/lib64:${LD_LIBRARY_PATH}
    export TF_CPP_MIN_LOG_LEVEL=1
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false
    # Safer allocator for large ESM models
    export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

%post
    set -e

    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        build-essential \
        cmake \
        git \
        wget \
        ncbi-blast+ \
        && rm -rf /var/lib/apt/lists/*

    python3 -m pip install --upgrade pip

    # The TensorFlow in this base (2.13.0+nv23.9) requires numpy<=1.24.3, and
    # numba in the base requires numpy<1.25 -- but several packages installed
    # below will happily pull numpy 1.26. A constraints file applies to every
    # pip invocation that follows, so numpy cannot be dragged forward no matter
    # which package asks for it.
    cat > /opt/thor-constraints.txt <<'EOF'
numpy<1.25
EOF
    export PIP_CONSTRAINT=/opt/thor-constraints.txt

    # --- TensorFlow side -------------------------------------------------
    # tensorflow itself comes from the NGC base; do not reinstall it.
    # NOT installed: tensorflow-addons.
    # THOR never constructs tfa layers - the only code that would is the
    # disabled CycleGan.load_models() - and spectral normalisation comes from
    # the vendored utils/layers_new.SpectralNormalization. The model modules
    # import it through utils/tfa_compat.py, which tolerates its absence.
    # This matters because tensorflow-addons publishes no aarch64 wheels, so
    # requiring it would make this image unbuildable on ARM GPU nodes, and
    # because the project reached end of life in May 2024.
    pip install tensorboard-plugin-profile==2.13.0
    # Deliberately NOT pinned here, unlike the older recipe this came from:
    #   protobuf==3.20            -> resolves to 3.20.0, below TF's >=3.20.3
    #                                and below cudf's >=4.21; nothing in THOR
    #                                imports protobuf directly.
    #   tensorflow-probability    -> 0.11.0 drags in cloudpickle==1.3.0 and
    #                                breaks dask/distributed in the base image;
    #                                unused by THOR.
    #   tifffile                  -> unused by THOR.
    # The base image already ships working versions of all three.

    # --- PyTorch + HuggingFace (ESM-1v) ----------------------------------
    # CUDA 11.8 wheels, to match the NGC TF 23.09 base.
    pip install torch==2.1.2 torchvision==0.16.2 torchaudio==2.1.2 \
        --extra-index-url https://download.pytorch.org/whl/cu118

    # The whole HuggingFace stack goes in ONE pip call so the resolver sees
    # every constraint at once. Installing datasets/accelerate separately
    # silently upgrades huggingface-hub past the <1.0 ceiling transformers
    # 4.41.2 requires, and the build then fails on import.
    #   transformers 4.41.2 -> huggingface-hub >=0.23.0,<1.0 ; tokenizers >=0.19,<0.20
    #   datasets     2.20.0 -> huggingface-hub >=0.21.2
    #   accelerate   0.33.0 -> huggingface-hub >=0.21.0
    pip install \
        transformers==4.41.2 \
        tokenizers==0.19.1 \
        huggingface-hub==0.23.2 \
        datasets==2.20.0 \
        accelerate==0.33.0

    # The base image ships NVIDIA's transformer_engine, compiled against the
    # PyTorch that came with it. Installing PyTorch from PyPI above leaves
    # transformer_engine's compiled extension (transformer_engine_extensions)
    # missing, so importing it raises ModuleNotFoundError. accelerate detects
    # the package purely by name and imports it, which makes `import accelerate`
    # fail -- and that breaks finetune_ESM.py. Nothing in THOR uses
    # transformer_engine, so remove the broken package outright.
    pip uninstall -y transformer-engine transformer_engine 2>/dev/null || true
    python3 - <<'PY'
import importlib.util, pathlib, shutil
spec = importlib.util.find_spec("transformer_engine")
if spec is not None and spec.submodule_search_locations:
    for loc in list(spec.submodule_search_locations):
        p = pathlib.Path(loc)
        print(f"[cleanup] removing leftover {p}")
        shutil.rmtree(p, ignore_errors=True)
else:
    print("[cleanup] transformer_engine not present")
PY

    # --- Project dependencies --------------------------------------------
    pip install biopython
    pip install pandas
    pip install PyYAML
    pip install matplotlib
    pip install scikit-learn
    pip install simple_pid
    pip install tqdm
    pip install typeguard==2.12.1

    # Ensure cuDNN >= 8.9 to match the TF build (TF 2.13 expects 8.9.5)
    pip install nvidia-cudnn-cu11==8.9.5.30
    CUDNN_PATH=$(python3 - <<'PY'
import nvidia.cudnn, os
print(os.path.join(os.path.dirname(nvidia.cudnn.__file__), "lib"))
PY
)
    echo "export LD_LIBRARY_PATH=${CUDNN_PATH}:\$LD_LIBRARY_PATH" >> /environment
    echo "export LD_LIBRARY_PATH=/usr/local/cuda/lib64:\$LD_LIBRARY_PATH" >> /environment

    # --- Fail the build now rather than at job submission ----------------
    # Report dependency conflicts, but do not fail on them: this base image
    # ships a large RAPIDS/dask stack that has pre-existing disagreements of
    # its own, and none of those affect THOR. The functional check below is
    # the real gate.
    echo "--- pip check (informational) ---"
    pip check || echo "(conflicts reported above; see whether they involve THOR's packages)"
    echo "---------------------------------"

    python3 - <<'PY'
import tensorflow as tf
import torch, transformers, datasets, accelerate
import yaml, pandas, numpy, sklearn, Bio, simple_pid, typeguard, tqdm
import h5py
print("TensorFlow        :", tf.__version__)
print("NumPy             :", numpy.__version__, "(TF 2.13 requires <=1.24.3)")
assert tuple(int(x) for x in numpy.__version__.split(".")[:2]) < (1, 25), \
    f"numpy {numpy.__version__} is too new for TensorFlow 2.13"
print("TensorFlow GPUs   :", tf.config.list_physical_devices("GPU"))
print("Torch             :", torch.__version__, "| CUDA build:", torch.version.cuda)
print("Transformers      :", transformers.__version__)
print("Datasets          :", datasets.__version__)
print("Accelerate        :", accelerate.__version__)
print("Platform          :", __import__("platform").machine())
PY

%runscript
    exec /bin/bash -lc "$@"

%help
    THOR - THermally Optimised Representations.

    One container for the whole pipeline. Typical use:

      singularity exec --nv thor.sif python train_thor.py -c <config>.yaml
      singularity exec --nv thor.sif python generate_thor.py --run_dir ... --fasta ...
      singularity exec --nv thor.sif python predict_et.py in.fasta out.fasta

    Not included: mmseqs2, used by data_processing/cluster.sh, which is run
    directly on the host rather than through this container.
