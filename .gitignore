# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
build/
dist/
*.egg-info/

# Python virtual environments
.venv/
venv/
.env/
*.env

# IDE and editor folders
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Jupyter artifacts
.ipynb_checkpoints/

# PyTorch artifacts
.cache/

# keras artifacts
.keras/

# nv artifacts
.nv/

# Checkpoints and training artifacts
weights/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx

# Logs
log/
logs/
*.log
*.out
*.err

# Project data (keep explicit docs and the shipped example)
# NOTE: 'data/*' rather than 'data/': git cannot re-include anything inside an
# excluded *directory*, so 'data/' would make every !data/... rule below dead.
data/*
results/
!data/README.md
!data/example_MDH/
!data/**/.gitkeep
# ...but not the TFRecords prepare_example.sh generates inside it.
data/example_MDH/records/

# Large numeric/data formats outside data/
*.h5
*.hdf5
*.npz
*.npy
*.mat
*.csv
*.tsv
*.parquet
*.jsonl
*.pkl

# TFRecords, wherever they land. '*.tfrecord' does not match
# '*.tfrecord.gz' - gitignore globs match the whole filename - so both
# patterns are needed, plus the sharded/plural spellings.
*.tfrecord
*.tfrecord.gz
*.tfrecords
*.tfrecords.gz

# SLURM and profiling outputs
*.prof
*.nvvp
profile/
src/scripts/data/log/

# Containers and archives
*.sif
*.tar
*.tar.gz
*.zip
*.7z
